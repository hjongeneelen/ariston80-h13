# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- Calendar (required) ---
# Public "Secret address in iCal format" from Google Calendar settings.
# Calendar > Settings and sharing > Integrate calendar > Secret address in iCal format
CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/80888c5d99065a461bd2c55cfe4f28c5269fe18e36662e2b998f1fcf4a1c7ac3%40group.calendar.google.com/public/basic.ics

# --- Google Sheet sync (optional, wire up once the sheet is finalized) ---
# See docs/google-sheets-setup.md for how to create these.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# "H13 gegevens" spreadsheet — tab 'H13 spelerslijst' + tab 'Aanwezigheid jaar 4'
GOOGLE_SHEET_ID=
# "H13 Boetesoverzicht 2026/27" spreadsheet — tab 'Boetes' (+ optional 'Tarieven').
# Optional: defaults to GOOGLE_SHEET_ID when unset.
GOOGLE_FINES_SHEET_ID=

# Shared secret required as a Bearer token / ?secret= query param to call
# /api/cron/sync-sheet by hand or from an external scheduler.
CRON_SECRET=change-me

# --- Access gate (optional) ---
# When set, the whole site requires this shared password to view (see
# src/proxy.ts). The site URL and repo stay public; only the content is
# gated. Leave unset to make the site fully open.
SITE_PASSWORD=
